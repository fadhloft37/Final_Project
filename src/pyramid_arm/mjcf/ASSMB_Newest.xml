<mujoco model="ASSMB_Newest">
  <compiler meshdir="meshes" angle="radian" discardvisual="false"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <asset>
    <mesh name="base_link_mesh"     file="base_link.STL"/>
    <mesh name="Base_mesh"          file="Base.STL"/>
    <mesh name="servo1_link_mesh"   file="servo1_link.STL"/>
    <mesh name="Servo2_link_mesh"   file="Servo2_link.STL"/>
    <mesh name="Servo3_Link_mesh"   file="Servo3_Link.STL"/>
    <mesh name="Servo4_link_mesh"   file="Servo4_link.STL"/>
    <mesh name="Servo5_link_mesh"   file="Servo5_link.STL"/>
    <mesh name="Servo6_link_mesh"   file="Servo6_link.STL"/>
    <material name="body_grey" rgba="0.792 0.820 0.933 1"/>
    <material name="end_white" rgba="1 1 1 1"/>
  </asset>

  <!-- Semua mesh = visual saja (contype=0 conaffinity=0).
       Yang bertabrakan cuma 2 kotak jari (finger1_col, finger2_col) dan benda di scene. -->
  <worldbody>
    <body name="base_link" pos="0 0 0">
      <inertial pos="-4.6466e-05 0.00033874 0.03682" mass="0.36838"
                diaginertia="0.0007506 0.0006837 0.0013386"/>
      <geom type="mesh" mesh="base_link_mesh" material="body_grey" contype="0" conaffinity="0"/>

      <body name="Base" pos="-0.00013877 -0.00011921 0.073800" quat="1 0 0 0">
        <inertial pos="9.9345e-05 -0.00040868 -0.037587" mass="0.33727"
                  diaginertia="0.0007458 0.0006821 0.0013335"/>
        <geom type="mesh" mesh="Base_mesh" material="body_grey" contype="0" conaffinity="0"/>

        <body name="servo1_link" pos="0 0 0" quat="1 0 0 0">
          <inertial pos="0.0020805 0.0014733 0.012277" mass="0.16283"
                    diaginertia="0.0001565 0.0001813 0.0003206"/>
          <joint name="Joint_1" type="hinge" axis="0 0 -1"
                 range="-3.14 3.14" limited="true" damping="0.05" armature="0.005"/>
          <geom type="mesh" mesh="servo1_link_mesh" material="body_grey" contype="0" conaffinity="0"/>

          <body name="Servo2_link" pos="0.01857 0 0.043" quat="0.707107 -0.707107 0 0">
            <inertial pos="0.10866 -2.3353e-05 0.044298" mass="0.071648"
                      diaginertia="8.14e-06 0.00016233 0.00016408"/>
            <joint name="Joint_2" type="hinge" axis="0 0 1"
                   range="-3.14 0.0" limited="true" damping="0.05" armature="0.005"/>
            <geom type="mesh" mesh="Servo2_link_mesh" material="body_grey" contype="0" conaffinity="0"/>

            <body name="Servo3_Link" pos="0.1549 -1.6401e-05 0" quat="0 1 0 0">
              <inertial pos="0.11108 -6.8085e-06 -0.0089609" mass="0.072647"
                        diaginertia="8.41e-06 0.00016240 0.00016423"/>
              <joint name="Joint_3" type="hinge" axis="0 0 -1"
                     range="-2.62 2.62" limited="true" damping="0.05" armature="0.005"/>
              <geom type="mesh" mesh="Servo3_Link_mesh" material="body_grey" contype="0" conaffinity="0"/>

              <body name="Servo4_link" pos="0.16641 0 0" quat="0 1 0 0">
                <inertial pos="0.038606 -0.00060031 0.047946" mass="0.052592"
                          diaginertia="8.43e-06 3.4617e-05 3.1201e-05"/>
                <joint name="Joint_4" type="hinge" axis="0 0 1"
                       range="-3.14 3.14" limited="true" damping="0.05" armature="0.005"/>
                <geom type="mesh" mesh="Servo4_link_mesh" material="body_grey" contype="0" conaffinity="0"/>

                <!-- Titik tengah antara dua jari. TEBAKAN AWAL, geser sampai pas dengan visual. -->
                <site name="tcp" pos="0.118 0 0.047" size="0.005" rgba="1 0 0 1"/>

                <body name="Servo5_link" pos="0.04099 -0.0021574 0.026587"
                      quat="0.707107 0.707107 0 0">
                  <inertial pos="0.014821 -0.0013726 -0.00075736" mass="0.011052"
                            diaginertia="7.06e-07 6.21e-06 6.78e-06"/>
                  <joint name="Joint_5" type="hinge" axis="0 0 1"
                         range="-3.14 0.0" limited="true" damping="0.01" armature="0.0005"/>
                  <geom type="mesh" mesh="Servo5_link_mesh" material="body_grey" contype="0" conaffinity="0"/>

                  <body name="End1" pos="0.076572 0.0060235 0" quat="1 0 0 0">
                    <!-- SEMENTARA: massa CAD asli 0.64 kg dengan COM 0.38 m tidak wajar. Tanyakan ke mekanikal. -->
                    <inertial pos="0.03 0 0" mass="0.02" diaginertia="1e-5 1e-5 1e-5"/>
                    <!-- Kotak tabrakan jari (TEBAKAN, atur pos/size supaya pas dengan mesh jari) -->
                    <geom name="finger1_col" type="box" pos="-0.03 0 0" size="0.03 0.004 0.01"
                          rgba="1 0 0 0.3" group="3" contype="1" conaffinity="1"
                          friction="1.5 0.005 0.0001"/>
                  </body>
                </body>

                <body name="Servo6_link" pos="0.040990 -0.0021574 0.067413"
                      quat="0.707107 0.707107 0 0">
                  <inertial pos="0.014685 0.0024293 -0.00075736" mass="0.011052"
                            diaginertia="7.56e-07 6.16e-06 6.78e-06"/>
                  <joint name="Joint_6" type="hinge" axis="0 0 1"
                         range="0.0 3.14" limited="true" damping="0.01" armature="0.0005"/>
                  <geom type="mesh" mesh="Servo6_link_mesh" material="body_grey" contype="0" conaffinity="0"/>

                  <body name="End2" pos="0.076806 -0.00053039 0" quat="1 0 0 0">
                    <inertial pos="0.03 0 0" mass="0.02" diaginertia="1e-5 1e-5 1e-5"/>
                    <geom name="finger2_col" type="box" pos="-0.03 0 0" size="0.03 0.004 0.01"
                          rgba="1 0 0 0.3" group="3" contype="1" conaffinity="1"
                          friction="1.5 0.005 0.0001"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- kv = peredam supaya tidak bergoyang -->
  <actuator>
    <position name="act_J1" joint="Joint_1" kp="50" kv="2"    ctrlrange="-3.14 3.14" forcerange="-1.08 1.08"/>
    <position name="act_J2" joint="Joint_2" kp="50" kv="2"    ctrlrange="-3.14 0.0"  forcerange="-3.43 3.43"/>
    <position name="act_J3" joint="Joint_3" kp="50" kv="2"    ctrlrange="-2.62 2.62" forcerange="-1.08 1.08"/>
    <position name="act_J4" joint="Joint_4" kp="50" kv="1"    ctrlrange="-3.14 3.14" forcerange="-1.08 1.08"/>
    <position name="act_J5" joint="Joint_5" kp="20" kv="0.1"  ctrlrange="-3.14 0.0"  forcerange="-0.29 0.29"/>
    <position name="act_J6" joint="Joint_6" kp="20" kv="0.1"  ctrlrange="0.0 3.14"   forcerange="-0.29 0.29"/>
  </actuator>

  <sensor>
    <jointpos name="jp1" joint="Joint_1"/>
    <jointpos name="jp2" joint="Joint_2"/>
    <jointpos name="jp3" joint="Joint_3"/>
    <jointpos name="jp4" joint="Joint_4"/>
    <jointpos name="jp5" joint="Joint_5"/>
    <jointpos name="jp6" joint="Joint_6"/>
  </sensor>

</mujoco>